{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cargo build (qemu_launcher)",
			"type": "shell",
			"command": "cargo",
			"args": [
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}/fuzzers/src/qemu_launcher_bucketing"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$rustc"
			],
			"presentation": {
				"reveal": "silent"
			}
		}
	]
}